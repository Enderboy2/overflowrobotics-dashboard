# Production Postgres (Neon via Vercel Storage sets this automatically).
# Leave unset locally to run on an embedded in-memory database with demo data.
DATABASE_URL=

# First admin account — created on the first deploy if it doesn't exist yet.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Optional, local only: persist the embedded database between restarts.
# PGLITE_DIR=./.data/pglite
